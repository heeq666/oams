{
  "schema_version": "0.2",
  "interface_id": "design-style-development",
  "name": "设计部款式开发打样进度",
  "org_unit_code": "DESIGN",
  "position_codes": [
    "DESIGN_LEAD"
  ],
  "capabilities": [
    "entries:write",
    "entries:read:dept",
    "aggregate:read:dept"
  ],
  "modules": [
    {
      "key": "layout",
      "type": "rows",
      "params": {
        "gap": "md"
      },
      "children": [
        {
          "key": "progress",
          "type": "progress_row",
          "module_version": "^1.0",
          "source_fields": [
            "title",
            "state_word",
            "progress_pct",
            "note_text",
            "evidence_ref"
          ]
        },
        {
          "key": "blocked",
          "type": "table",
          "module_version": "^1.0",
          "params": {
            "columns": [
              {
                "key": "blocked_reason",
                "label": "卡在哪、在等谁、等多久"
              },
              {
                "key": "needs_decision",
                "label": "是否需要管理层拍板"
              }
            ],
            "rows": 1
          },
          "source_fields": [
            "blocked_reason",
            "needs_decision"
          ]
        },
        {
          "key": "centredata",
          "type": "table",
          "module_version": "^1.0",
          "params": {
            "columns": [
              {
                "key": "wave_ref",
                "label": "涉及波次"
              },
              {
                "key": "style_count_ref",
                "label": "涉及款数"
              },
              {
                "key": "sample_done_ref",
                "label": "已出样件数（商品中心）"
              },
              {
                "key": "sample_status_ref",
                "label": "商品中心打样状态"
              }
            ],
            "rows": 1
          },
          "source_fields": [
            "wave_ref",
            "style_count_ref",
            "sample_done_ref",
            "sample_status_ref"
          ]
        },
        {
          "key": "private",
          "type": "table",
          "module_version": "^1.0",
          "aggregatable": false,
          "params": {
            "columns": [
              {
                "key": "fabric_note",
                "label": "部门内部备注"
              }
            ],
            "rows": 1
          },
          "source_fields": [
            "fabric_note"
          ]
        }
      ]
    }
  ],
  "fields": [
    {
      "key": "title",
      "label": "汇报事项",
      "type": "text",
      "required": true,
      "map_to": "title",
      "aggregatable": true,
      "example": "26D冬3-4波 款式开发打样周进度"
    },
    {
      "key": "report_cycle",
      "label": "汇报周期",
      "type": "text",
      "required": false,
      "map_to": "display_only",
      "aggregatable": false,
      "example": "每周一"
    },
    {
      "key": "state_word",
      "label": "整体状态",
      "type": "enum",
      "required": true,
      "map_to": "status",
      "aggregatable": true,
      "example": "进行中",
      "options": [
        "未开始",
        "进行中",
        "等审批",
        "等版房",
        "等面料到仓",
        "本周暂停",
        "已完成"
      ]
    },
    {
      "key": "progress_pct",
      "label": "完成率",
      "type": "number",
      "required": true,
      "map_to": "progress_value",
      "aggregatable": true,
      "example": "65"
    },
    {
      "key": "blocked_reason",
      "label": "卡在哪、在等谁、等多久",
      "type": "text",
      "required": false,
      "map_to": "blocked_reason",
      "aggregatable": true,
      "example": "等版房排期，版师本周满负荷，预计 10-20 出样"
    },
    {
      "key": "needs_decision",
      "label": "是否需要管理层拍板",
      "type": "enum",
      "required": false,
      "map_to": "needs_decision",
      "aggregatable": true,
      "example": "否",
      "options": [
        "是",
        "否"
      ]
    },
    {
      "key": "note_text",
      "label": "本次进展与下步计划",
      "type": "text",
      "required": true,
      "map_to": "note",
      "aggregatable": true,
      "example": "本周完成 12 款头版出样，下周推进配色确认"
    },
    {
      "key": "evidence_ref",
      "label": "依据（单号/文件名）",
      "type": "text",
      "required": true,
      "map_to": "evidence",
      "aggregatable": true,
      "example": "打样台账 26D冬3-4波 统计截至 10-13"
    },
    {
      "key": "evidence_time",
      "label": "依据时间",
      "type": "date",
      "required": true,
      "map_to": "display_only",
      "aggregatable": false,
      "example": "2026-10-13"
    },
    {
      "key": "owner_position",
      "label": "责任岗位",
      "type": "text",
      "required": true,
      "map_to": "display_only",
      "aggregatable": false,
      "example": "设计负责人"
    },
    {
      "key": "wave_ref",
      "label": "涉及波次",
      "type": "text",
      "required": false,
      "map_to": "display_only",
      "aggregatable": false,
      "example": "26D冬3-4波"
    },
    {
      "key": "style_count_ref",
      "label": "涉及款数",
      "type": "number",
      "required": false,
      "map_to": "display_only",
      "aggregatable": false,
      "example": "18"
    },
    {
      "key": "sample_done_ref",
      "label": "已出样件数（商品中心）",
      "type": "number",
      "required": false,
      "map_to": "display_only",
      "aggregatable": false,
      "example": "12"
    },
    {
      "key": "sample_status_ref",
      "label": "商品中心打样状态",
      "type": "text",
      "required": false,
      "map_to": "display_only",
      "aggregatable": false,
      "example": "已出样"
    },
    {
      "key": "fabric_note",
      "label": "部门内部备注",
      "type": "text",
      "required": false,
      "map_to": "display_only",
      "aggregatable": false,
      "example": "面料待补货"
    }
  ],
  "status_map": {
    "未开始": "planned",
    "进行中": "in_progress",
    "等审批": "blocked",
    "等版房": "blocked",
    "等面料到仓": "blocked",
    "本周暂停": "blocked",
    "已完成": "done"
  },
  "rules": {
    "evidence_required": true,
    "blocked_reason_required_when_blocked": true,
    "progress_range": [
      0,
      100
    ]
  },
  "meta": {
    "author_position_code": "DESIGN_LEAD",
    "version": 3,
    "visibility": "department",
    "review": {
      "status": "active"
    }
  }
}