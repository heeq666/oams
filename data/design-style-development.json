{
  "schema_version": "0.1",
  "interface_id": "design-style-development-sampling",
  "name": "设计部款式开发打样进度",
  "org_unit_code": "DESIGN",
  "position_codes": ["DESIGN_LEAD"],
  "modules": [
    { "key": "item", "type": "item_card", "title": "汇报事项", "order": 1,
      "source_fields": ["title", "report_cycle"], "aggregatable": true },
    { "key": "scope", "type": "list_block", "title": "涉及商品中心数据（只读引用）", "order": 2,
      "source_fields": ["wave_ref", "style_count_ref", "sample_done_ref", "sample_status_ref"], "aggregatable": false },
    { "key": "state", "type": "metric_card", "title": "整体状态", "order": 3,
      "source_fields": ["state_word"], "aggregatable": true },
    { "key": "progress", "type": "progress_bar", "title": "完成率", "order": 4,
      "source_fields": ["progress_pct"], "aggregatable": true },
    { "key": "blocked", "type": "blocked_card", "title": "卡在哪、在等谁、等多久", "order": 5,
      "source_fields": ["blocked_reason"], "aggregatable": true },
    { "key": "decision", "type": "decision_card", "title": "是否需要管理层拍板", "order": 6,
      "source_fields": ["needs_decision"], "aggregatable": true },
    { "key": "note", "type": "item_card", "title": "本次进展与下步计划", "order": 7,
      "source_fields": ["note_text"], "aggregatable": true },
    { "key": "evidence", "type": "evidence_input", "title": "依据", "order": 8,
      "source_fields": ["evidence_ref", "evidence_time"], "aggregatable": true },
    { "key": "owner", "type": "owner_block", "title": "责任岗位", "order": 9,
      "source_fields": ["owner_position"], "aggregatable": true },
    { "key": "private", "type": "list_block", "title": "部门内部备注", "order": 10,
      "source_fields": ["fabric_note"], "aggregatable": false }
  ],
  "fields": [
    { "key": "title", "label": "汇报事项", "type": "text", "required": true, "map_to": "title",
      "aggregatable": true, "example": "26D冬3-4波 款式开发打样周进度" },
    { "key": "state_word", "label": "整体状态", "type": "enum", "required": true, "map_to": "status",
      "aggregatable": true, "example": "进行中",
      "options": ["未开始", "进行中", "等审批", "等版房", "等面料到仓", "本周暂停", "已完成"] },
    { "key": "progress_pct", "label": "完成率", "type": "number", "required": true, "map_to": "progress_value",
      "aggregatable": true, "example": "65" },
    { "key": "blocked_reason", "label": "卡在哪、在等谁、等多久", "type": "text", "required": false,
      "map_to": "blocked_reason", "aggregatable": true, "example": "等版房排期，版师本周满负荷，预计 10-20 出样" },
    { "key": "needs_decision", "label": "是否需要管理层拍板", "type": "enum", "required": false,
      "map_to": "needs_decision", "aggregatable": true, "example": "否" },
    { "key": "note_text", "label": "本次进展与下步计划", "type": "text", "required": true, "map_to": "note",
      "aggregatable": true, "example": "本周完成 12 款头版出样，下周推进配色确认" },
    { "key": "evidence_ref", "label": "依据（单号/文件名）", "type": "text", "required": true, "map_to": "evidence",
      "aggregatable": true, "example": "打样台账 26D冬3-4波 统计截至 10-13" },
    { "key": "evidence_time", "label": "依据时间", "type": "date", "required": true, "map_to": "display_only",
      "aggregatable": false, "example": "2026-10-13" },
    { "key": "owner_position", "label": "责任岗位", "type": "text", "required": true, "map_to": "position_id",
      "aggregatable": true, "example": "设计负责人" },
    { "key": "report_cycle", "label": "汇报周期", "type": "text", "required": false, "map_to": "display_only",
      "aggregatable": false, "example": "每周一" },
    { "key": "wave_ref", "label": "涉及波次", "type": "text", "required": false, "map_to": "display_only",
      "aggregatable": false, "example": "26D冬3-4波" },
    { "key": "style_count_ref", "label": "涉及款数", "type": "number", "required": false, "map_to": "display_only",
      "aggregatable": false, "example": "18" },
    { "key": "sample_done_ref", "label": "已出样件数（商品中心）", "type": "number", "required": false, "map_to": "display_only",
      "aggregatable": false, "example": "12" },
    { "key": "sample_status_ref", "label": "商品中心打样状态", "type": "text", "required": false, "map_to": "display_only",
      "aggregatable": false, "example": "已出样" },
    { "key": "fabric_note", "label": "部门内部备注", "type": "text", "required": false, "map_to": "display_only",
      "aggregatable": false, "example": "面料待补货" }
  ],
  "status_map": {
    "未开始": "planned",
    "进行中": "in_progress",
    "等审批": "blocked",
    "等版房": "blocked",
    "等面料到仓": "blocked",
    "本周暂停": "blocked",
    "已完成": "done"
  },
  "rules": {
    "evidence_required": true,
    "blocked_reason_required_when_blocked": true,
    "progress_range": [0, 100]
  },
  "meta": {
    "author_position_code": "DESIGN_LEAD",
    "version": 2,
    "visibility": "department",
    "review": { "status": "draft" }
  }
}
