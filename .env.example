WORKHUB_DATABASE_URL=postgresql://workhub_runtime:change-me@127.0.0.1:5433/workhub
WORKHUB_SESSION_TTL_HOURS=8
WORKHUB_BIND_HOST=127.0.0.1
WORKHUB_BIND_PORT=8000

# The product data centre that company metrics (已出样 / 已下单 / 下单金额 / ROI) are
# read from. Leave it unset on a workstation that cannot reach the LAN: the board
# then shows "指标暂不可用" and everything else keeps working.
# WORKHUB_DATACENTER_URL=http://product-hub.example.com:8791/mcp

# Recorded payloads for offline work, same shape as the data centre's responses
# (see tests/fixtures/datacenter_26d.json). Takes precedence over the URL above.
# WORKHUB_DATACENTER_FIXTURE=tests/fixtures/datacenter_26d.json

# Which product wave the home page reports on. Unset means the data centre's first
# wave; pin it when a season rolls over and the metrics must not follow.
# WORKHUB_DEFAULT_WAVE=26D冬1-2波

# Account-center settings are intentionally absent until its authentication
# contract is approved. Do not invent issuer URLs, client IDs or secrets here.
# See docs/runbooks/account-center-integration.md.
