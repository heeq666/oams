WORKHUB_DATABASE_URL=postgresql://workhub_runtime:change-me@127.0.0.1:5433/workhub
WORKHUB_SESSION_TTL_HOURS=8
WORKHUB_BIND_HOST=127.0.0.1
WORKHUB_BIND_PORT=8000

# WeCom (企业微信) login. Fill these in .env only, never commit real values.
# CorpID and AgentID are not secret; Secret is. See docs/runbooks/wecom-oauth-handover.md
WORKHUB_WECOM_CORP_ID=
WORKHUB_WECOM_AGENT_ID=
WORKHUB_WECOM_APP_SECRET=
# Public base URL that resolves to the service. Must match the WeCom trusted domain.
WORKHUB_PUBLIC_BASE_URL=https://workhub.example.com
# Callback path served by Workhub. Keep this value; it is appended to the base URL.
WORKHUB_WECOM_REDIRECT_PATH=/api/auth/wecom/callback
# Login entry points to serve: qr (browser scan), in_client (WeCom workbench), or both.
WORKHUB_WECOM_LOGIN_ENTRY=both
